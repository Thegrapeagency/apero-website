{
  "redirects": [
    {
      "source": "/viltjes",
      "destination": "/viltjes.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://apero-werkplaats.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://apero-werkplaats.vercel.app/dashboard/:path*"
    },
    {
      "source": "/tickets",
      "destination": "/tickets.html"
    },
    {
      "source": "/bedankt",
      "destination": "/bedankt.html"
    },
    {
      "source": "/scanner",
      "destination": "/scanner.html"
    },
    {
      "source": "/voorwaarden",
      "destination": "/voorwaarden.html"
    },
    {
      "source": "/ticketbeheer",
      "destination": "/ticketbeheer.html"
    }
  ],
  "headers": [
    {
      "source": "/(tickets|bedankt|ticketbeheer|scanner)(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
