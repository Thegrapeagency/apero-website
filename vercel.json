{
  "buildCommand": "node tools/bouw.mjs && rm -rf tools content docs",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/viltjes",
      "destination": "/viltjes.html",
      "permanent": false
    },
    {
      "source": "/pitch.html",
      "destination": "/pitch",
      "permanent": false
    },
    {
      "source": "/inschenker.html",
      "destination": "/nieuwsbrief.html",
      "permanent": true
    },
    {
      "source": "/inschenker",
      "destination": "/nieuwsbrief.html",
      "permanent": true
    },
    {
      "source": "/nieuwsbrief",
      "destination": "/nieuwsbrief.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://apero-werkplaats.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/",
      "destination": "https://apero-werkplaats.vercel.app/dashboard/"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://apero-werkplaats.vercel.app/dashboard/:path*"
    },
    {
      "source": "/pitch",
      "destination": "https://apero-werkplaats.vercel.app/dashboard/pitch"
    },
    {
      "source": "/p/:code",
      "destination": "https://apero-werkplaats.vercel.app/dashboard/p/:code"
    },
    {
      "source": "/tickets",
      "destination": "/tickets.html"
    },
    {
      "source": "/bedankt",
      "destination": "/bedankt.html"
    },
    {
      "source": "/scanner",
      "destination": "/scanner.html"
    },
    {
      "source": "/voorwaarden",
      "destination": "/voorwaarden.html"
    },
    {
      "source": "/ticketbeheer",
      "destination": "/ticketbeheer.html"
    }
  ],
  "headers": [
    {
      "source": "/(tickets|bedankt|ticketbeheer|scanner)(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(pitch|p/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
